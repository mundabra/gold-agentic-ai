# Copy to .env and pick ONE of the options below.

# --- No API key: a scripted stand-in model answers the example questions.
#     docker compose --profile scripted up --build
GOLD_LLM_BASE_URL=http://scripted-model:8000/v1
GOLD_LLM_API_KEY=not-needed

# --- Stage 1: one hosted OpenAI-compatible API.
#     Use a model with solid tool calling for the agents; any good SQL model for gold-sql.
# GOLD_LLM_BASE_URL=https://your-provider.example/v1
# GOLD_LLM_API_KEY=your-key
# GOLD_ORCHESTRATOR_MODEL=provider/model-with-tool-calling
# GOLD_AGENT_MODEL=provider/model-with-tool-calling
# GOLD_SQL_MODEL=provider/good-sql-model

# --- Stages 2 and 3: the LiteLLM gateway routes the roles gold-general and gold-sql
#     to whichever endpoints you configure in deploy/litellm/config.yaml.
#     docker compose --profile gateway up --build
# GOLD_LLM_BASE_URL=http://litellm:4000/v1
# GOLD_LLM_API_KEY=sk-gold-local          # also the gateway's master key
# GENERAL_API_BASE=https://your-provider.example/v1
# GENERAL_API_KEY=your-key
# GENERAL_MODEL=openai/provider/model-with-tool-calling   # "openai/" = OpenAI-compatible
# SQL_API_BASE=http://your-vllm:8000/v1    # e.g. your fine-tuned model
# SQL_API_KEY=not-needed
# SQL_MODEL=openai/gold-sql

# --- A fine-tuned SQL model must see exactly the prompt it was trained on.
#     For example, a model trained on bare questions with its own system prompt:
# GOLD_SQL_SYSTEM_PROMPT=You are a SQL assistant. Answer the question with a single PostgreSQL query.
# GOLD_SQL_INCLUDE_SCHEMA=false
# GOLD_SQL_PASS_DEFINITIONS=false

# --- NVIDIA NeMo Guardrails (optional). With --profile guardrails the server runs locally.
# GOLD_RAILS_URL=http://guardrails:8000
# GOLD_RAILS_MODEL=provider/model-for-the-policy-checks   # defaults to gold-general
# GOLD_RAILS_CHECK_ANSWERS=true

# --- Tracing (OpenTelemetry). Any OTLP backend works; with --profile tracing, Jaeger runs locally.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# GOLD_TRACE_CONTENT=false               # true puts prompts, SQL and results into spans
